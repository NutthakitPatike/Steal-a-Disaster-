      </Properties>
      <Item class="Script" referent="6">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

print(("[Server] %s prototype %s ready"):format(Config.WorkingTitle, Config.PrototypeVersion))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">PrototypeWorld</string>
          <string name="Source"><![CDATA[--!strict
-- Studio-only original procedural map: hub plus five themed sequential zones.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PrototypeConfig"))
local ZoneMap = require(script.Parent:WaitForChild("ZoneMap"))
local World = {}

local function part(
    parent: Instance,
    name: string,
    position: Vector3,
    size: Vector3,
    color: Color3,
    collides: boolean?
): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Anchored = true
    p.Size = size
    p.Position = position
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.CanCollide = collides ~= false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function label(parent: Instance, name: string, text: string, offset: Vector3?): BillboardGui
    local gui = Instance.new("BillboardGui")
    gui.Name = name
    gui.AlwaysOnTop = true
    gui.Size = UDim2.fromOffset(260, 63)
    gui.StudsOffsetWorldSpace = offset or Vector3.new(0, 5, 0)
    gui.MaxDistance = 180
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundColor3 = Color3.fromRGB(20, 27, 38)
    t.BackgroundTransparency = 0.17
    t.TextColor3 = Color3.fromRGB(250, 251, 255)
    t.TextStrokeTransparency = 0.65
    t.TextScaled = true
    t.Font = Enum.Font.GothamBold
    t.Text = text
    t.Parent = gui
    gui.Parent = parent
    return gui
end

local function prompt(owner: BasePart, action: string, hold: number): ProximityPrompt
    local p = Instance.new("ProximityPrompt")
    p.Name = action .. "Prompt"
    p.ActionText = action
    p.ObjectText = "Containment Crate"
    p.KeyboardKeyCode = Enum.KeyCode.E
    p.HoldDuration = hold
    p.MaxActivationDistance = 12
    p.RequiresLineOfSight = false
    p.Parent = owner
    return p
end

function World.create(name: string)
    -- A saved Studio Place takes priority: its Parts/Models already exist in Workspace.
    -- The fallback below is kept only for a blank Rojo test place.
    local existing = workspace:FindFirstChild(name)
    if existing then
        local zones = {}
        for zoneId, definition in ipairs(Config.Zones) do
            local folderName = ("Zone%02d_%s"):format(zoneId, definition.Name:gsub("%s+", ""))
            local folder = assert(
                existing:FindFirstChild(folderName, true),
                "Missing saved Zone: " .. folderName
            )
            local guard =
                assert(folder:FindFirstChild("Warden_" .. zoneId), "Missing saved Warden") :: BasePart
            local gate = assert(
                folder:FindFirstChild("SafeExit_" .. zoneId),
                "Missing saved safe exit"
            ) :: BasePart
            local nodes = {}
            for j = 1, 2 do
                local marker = assert(
                    folder:FindFirstChild("CrateSpawn" .. j),
                    "Missing saved crate marker"
                ) :: BasePart
                table.insert(nodes, marker.Position + Vector3.new(0, 2.9, 0))
            end
            table.insert(zones, {
                id = zoneId,
                name = definition.Name,
                folder = folder,
                nodes = nodes,
                centerZ = guard.Position.Z + 20,
                safeExitZ = gate.Position.Z + 1,
                warden = guard,
                guardOrigin = guard.Position,
            })
        end
        local plots = {}
        for slot = 1, 7 do
            local pad = assert(
                existing:FindFirstChild("TestPlot" .. slot, true),
                "Missing saved base pad"
            ) :: BasePart
            local station = assert(
                existing:FindFirstChild("CrateOpener" .. slot, true),
                "Missing saved opener"
            ) :: BasePart
            local open = assert(
                station:FindFirstChild("Open CratePrompt"),
                "Missing saved opener prompt"
            ) :: ProximityPrompt
            table.insert(plots, { pad = pad, station = station, open = open })
        end
        local trainer =
            assert(existing:FindFirstChild("SpeedTrainer", true), "Missing saved Speed trainer")
        local trainPrompt = assert(
            trainer:FindFirstChild("Train +10 SpeedPrompt"),
            "Missing saved trainer prompt"
        ) :: ProximityPrompt
        return {
            root = existing,
            zones = zones,
            plots = plots,
            trainPrompt = trainPrompt,
            part = part,
            label = label,
            prompt = prompt,
        }
    end
    assert(workspace:FindFirstChild(name) == nil, "Prototype workspace already exists")
    local root = Instance.new("Folder")
    root.Name = name
    root.Parent = workspace

    part(
        root,
        "HubFloor",
        Vector3.new(0, -1, 9),
        Vector3.new(310, 2, 140),
        Color3.fromRGB(90, 110, 127)
    )
    part(
        root,
        "MainApproach",
        Vector3.new(0, -1, -96),
        Vector3.new(44, 2, 112),
        Color3.fromRGB(155, 160, 155)
    )
    part(
        root,
        "ReturnApproach",
        Vector3.new(46, -1, -96),
        Vector3.new(12, 2, 112),
        Color3.fromRGB(169, 213, 220)
    )
    local zones = ZoneMap.create(root, part, label, Config)

    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "PrototypeSpawn"
    spawn.Size = Vector3.new(12, 1, 12)
    spawn.Anchored = true
    spawn.Position = Vector3.new(0, 0.4, 54)
    spawn.Neutral = true
    spawn.Transparency = 0.25
    spawn.Color = Color3.fromRGB(125, 208, 208)
    spawn.Parent = root
    label(spawn, "SpawnSign", "STEAL A DISASTER! TEST HUB", Vector3.new(0, 5, 0))

    local guide = part(
        root,
        "MapGuide",
        Vector3.new(30, 4, -44),
        Vector3.new(3, 8, 3),
        Color3.fromRGB(80, 174, 190),
        false
    )
    label(guide, "MapLabel", "5 ZONES STRAIGHT AHEAD\nRETURN LANE ON RIGHT", Vector3.new(0, 8, 0))

    -- Seven prototype bases support the 7-player reference-style arrangement.
    local plots = {}
    for slot = 1, 7 do
        local x = (slot - 4) * 41
        local pad = part(
            root,
            "TestPlot" .. slot,
            Vector3.new(x, 0, 0),
            Vector3.new(24, 1, 27),
            Color3.fromRGB(108, 124, 167),
            false
        )
        label(pad, "PlotSign", "FREE TEST BASE " .. slot, Vector3.new(0, 5, -7))
        local station = part(
            root,
            "CrateOpener" .. slot,
            Vector3.new(x, 3, 6),
            Vector3.new(7, 5, 7),
            Color3.fromRGB(221, 181, 92),
            false
        )
        label(station, "OpenSign", "OPEN SECURED CRATE", Vector3.new(0, 6, 0))
        local open = prompt(station, "Open Crate", 0.35)
        open.ObjectText = "Your Base"
        table.insert(plots, { pad = pad, station = station, open = open })
    end

    local trainer = part(
        root,
        "SpeedTrainer",
        Vector3.new(0, 2, 28),
        Vector3.new(11, 4, 10),
        Color3.fromRGB(82, 160, 233),
        false
    )
    label(trainer, "TrainSign", "TRAIN SPEED POWER", Vector3.new(0, 6, 0))
    local trainPrompt = prompt(trainer, "Train +10 Speed", 0.5)
    trainPrompt.ObjectText = "Practice Treadmill"

    return {
        root = root,
        zones = zones,
        plots = plots,
        trainPrompt = trainPrompt,
        part = part,
        label = label,
        prompt = prompt,
    }
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">TornadoTownPrototype</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Studio-only, no persistent DataStore writes or live publishing.
-- One reusable, server-owned crate/chase/open loop across five original Zone scenes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PrototypeConfig"))
local World = require(script.Parent:WaitForChild("PrototypeWorld"))

if not Config.Enabled or not RunService:IsStudio() then
    return
end

local remotes = Instance.new("Folder")
remotes.Name = "PrototypeRemotes"
remotes.Parent = ReplicatedStorage
local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = remotes

local world = World.create(Config.WorldName)
local rng = Random.new()
local profiles = {}
local occupiedPlots = {}
local activeCrates = {}
local nextCrateId = 0
local spawnCrate

local function notify(player, message)
    if player.Parent == Players then
        notifyEvent:FireClient(player, message)
    end
end

local function characterRoot(player)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then
        return nil, nil
    end
    return root, humanoid
end

local function within(player, position, radius)
    local root = characterRoot(player)
    return root ~= nil and (root.Position - position).Magnitude <= radius
end

local function unlockedZone(speedPower)
    local highest = 1
    for zoneId, definition in ipairs(Config.Zones) do
        if speedPower >= definition.RequiredSpeed then
            highest = zoneId
        end
    end
    return highest
end

local function updateValues(player, profile)
    player:SetAttribute("ChaosCoins", profile.coins)
    player:SetAttribute("SpeedPower", profile.speedPower)
    player:SetAttribute("HighestZone", unlockedZone(profile.speedPower))
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        stats.Coins.Value = profile.coins
        stats.Speed.Value = profile.speedPower
    end
end

local function updateCarry(player, profile)
    local carry = profile.carry
    player:SetAttribute("CarryStatus", carry and carry.status or "Empty")
    player:SetAttribute("CarryingTier", carry and carry.tier or "")
    player:SetAttribute("CarryingZone", carry and carry.zoneId or 0)
end

local function clearCarry(player, profile, message)
    local carry = profile.carry
    if not carry then
        return
    end
    profile.carry = nil
    profile.slowUntil = 0
    if carry.visual then
        carry.visual:Destroy()
    end
    updateCarry(player, profile)
    if message then
        notify(player, message)
    end
end

local function equipVisual(player, tier)
    local root = characterRoot(player)
    if not root then
        return nil
    end
    local visual = Instance.new("Part")
    visual.Name = "CarriedContainmentCrate"
    visual.Size = Vector3.new(3.4, 3.4, 3.4)
    visual.Color = if tier == "Rare"
        then Color3.fromRGB(218, 150, 255)
        else Color3.fromRGB(120, 213, 228)
    visual.Material = Enum.Material.Neon
    visual.CanCollide = false
    visual.CanQuery = false
    visual.CanTouch = false
    visual.Massless = true
    visual.CFrame = root.CFrame * CFrame.new(0, 1, -2.5)
    visual.Parent = player.Character
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = visual
    weld.Parent = visual
    return visual
end

local function chooseTier()
    local total = 0
    for _, weight in pairs(Config.CrateTierWeights) do
        total += weight
    end
    local roll = rng:NextNumber(0, total)
    local cumulative = 0
    for _, tier in ipairs({ "Common", "Rare" }) do
        cumulative += Config.CrateTierWeights[tier] or 0
        if roll <= cumulative then
            return tier
        end
    end
    return "Common"
end

local function takeCrate(player, zoneId, instanceId, method)
    local profile = profiles[player]
    local crate = activeCrates[zoneId]
    if not profile or profile.carry or not crate or crate.id ~= instanceId or crate.claimed then
        return
    end
    if not within(player, crate.position, Config.CaptureDistance) then
        return
    end
    if profile.speedPower < Config.Zones[zoneId].RequiredSpeed then
        notify(
            player,
            ("Zone %d needs %d Speed Power. Train first."):format(
                zoneId,
                Config.Zones[zoneId].RequiredSpeed
            )
        )
        return
    end

    -- No yield until after the ownership claim and carry assignment.
    crate.claimed = true
    activeCrates[zoneId] = nil
    crate.model:Destroy()
    local visual = equipVisual(player, crate.tier)
    if not visual then
        task.delay(Config.CrateRespawnSeconds, function()
            spawnCrate(zoneId)
        end)
        return
    end
    profile.carry = {
        id = instanceId,
        tier = crate.tier,
        zoneId = zoneId,
        method = method,
        status = "Escaping",
        capturedAt = os.clock(),
        visual = visual,
        slowApplied = false,
    }
    updateCarry(player, profile)
    notify(
        player,
        ("ZONE %d %s crate! %s: run to the green exit."):format(zoneId, crate.tier, method)
    )
    if method == "Snatch" then
        notify(player, "UNSTABLE: a brief slowdown is coming!")
    end
    task.delay(Config.CrateRespawnSeconds, function()
        spawnCrate(zoneId)
    end)
end

function spawnCrate(zoneId)
    if activeCrates[zoneId] or not world.root.Parent then
        return
    end
    local zone = world.zones[zoneId]
    if not zone then
        return
    end
    nextCrateId += 1
    local id = nextCrateId
    local tier = chooseTier()
    local position = zone.nodes[rng:NextInteger(1, #zone.nodes)]
    local model = Instance.new("Model")
    model.Name = "Zone" .. zoneId .. "_Crate_" .. id
    model.Parent = zone.folder
    local core = world.part(
        model,
        tier .. " Containment Crate",
        position,
        Vector3.new(5, 5, 5),
        if tier == "Rare" then Color3.fromRGB(166, 110, 240) else Color3.fromRGB(100, 190, 218),
        false
    )
    core.Material = Enum.Material.Neon
    world.label(core, "TierSign", tier:upper() .. " CRATE - ZONE " .. zoneId, Vector3.new(0, 6, 0))
    for _, option in ipairs({
        { name = "Stabilize", seconds = 2.0, deltaX = -7, color = Color3.fromRGB(75, 186, 160) },
        { name = "Snatch", seconds = 0.0, deltaX = 7, color = Color3.fromRGB(239, 169, 87) },
    }) do
        local button = world.part(
            model,
            option.name .. "Handle",
            position + Vector3.new(option.deltaX, -1, 0),
            Vector3.new(4, 3, 4),
            option.color,
            false
        )
        local prompt = world.prompt(button, option.name, option.seconds)
        prompt.Triggered:Connect(function(player)
            takeCrate(player, zoneId, id, option.name)
        end)
        world.label(button, option.name .. "Sign", option.name, Vector3.new(0, 4.5, 0))
    end
    activeCrates[zoneId] =
        { id = id, tier = tier, model = model, position = position, claimed = false }
end

local function openAtBase(player, slot)
    local profile = profiles[player]
    if not profile or profile.plotSlot ~= slot or occupiedPlots[slot] ~= player.UserId then
        return
    end
    if not within(player, world.plots[slot].station.Position, Config.BaseOpenDistance) then
        return
    end
    local carry = profile.carry
    if not carry or carry.status ~= "Secured" then
        notify(player, "Escape with a crate, then open it at YOUR base.")
        return
    end

    -- Consume before the grant; one valid open even under rapid prompts.
    profile.carry = nil
    if carry.visual then
        carry.visual:Destroy()
    end
    updateCarry(player, profile)
    local pool = Config.Rewards[carry.zoneId][carry.tier]
    assert(pool and #pool > 0, "Zone crate tier has no reward pool")
    local disaster = pool[rng:NextInteger(1, #pool)]
    profile.inventory[disaster] = (profile.inventory[disaster] or 0) + 1
    profile.index[carry.zoneId .. ":" .. disaster] = true
    profile.coins += Config.Earnings[carry.tier]
    local discovered = 0
    for _ in pairs(profile.index) do
        discovered += 1
    end
    player:SetAttribute("IndexCount", discovered)
    updateValues(player, profile)
    notify(
        player,
        ("ZONE %d REVEAL: %s %s | +%d Coins (memory-only)"):format(
            carry.zoneId,
            carry.tier,
            disaster,
            Config.Earnings[carry.tier]
        )
    )
end

local function train(player)
    local profile = profiles[player]
    if not profile or not within(player, world.trainPrompt.Parent.Position, 15) then
        return
    end
    local now = os.clock()
    if now - profile.lastTrain < Config.SpeedTrainingCooldown then
        return
    end
    profile.lastTrain = now
    local previous = unlockedZone(profile.speedPower)
    profile.speedPower =
        math.min(Config.MaxSpeedPower, profile.speedPower + Config.SpeedTrainingAmount)
    updateValues(player, profile)
    if unlockedZone(profile.speedPower) > previous then
        notify(player, "NEW ZONE UNLOCKED: " .. Config.Zones[unlockedZone(profile.speedPower)].Name)
    end
end

local function assignPlayer(player)
    local slot
    for i = 1, #world.plots do
        if occupiedPlots[i] == nil then
            slot = i
            break
        end
    end
    if not slot then
        player:Kick("All temporary prototype bases are occupied.")
        return
    end
    occupiedPlots[slot] = player.UserId
    local profile = {
        coins = 0,
        speedPower = 0,
        inventory = {},
        index = {},
        carry = nil,
        slowUntil = 0,
        lastTrain = -100,
        plotSlot = slot,
    }
    profiles[player] = profile
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player
    for _, name in ipairs({ "Coins", "Speed" }) do
        local value = Instance.new("IntValue")
        value.Name = name
        value.Parent = stats
    end
    player:SetAttribute("IndexCount", 0)
    updateValues(player, profile)
    updateCarry(player, profile)
    local gui = world.plots[slot].pad:FindFirstChild("PlotSign")
    local text = gui and gui:FindFirstChildOfClass("TextLabel")
    if text then
        text.Text = "BASE: " .. player.DisplayName
    end
    player.CharacterAdded:Connect(function(character)
        clearCarry(player, profile, nil)
        local human = character:WaitForChild("Humanoid", 10)
        if human then
            human.WalkSpeed = Config.WalkSpeedBase
            human.Died:Connect(function()
                clearCarry(player, profile, "Crate dropped on death.")
            end)
        end
        task.delay(1.5, function()
            notify(
                player,
                "Base " .. slot .. ": train, travel the long road and carry a crate home."
            )
        end)
    end)
end

local function removePlayer(player)
    local profile = profiles[player]
    if not profile then
        return
    end
    clearCarry(player, profile, nil)
    occupiedPlots[profile.plotSlot] = nil
    local gui = world.plots[profile.plotSlot].pad:FindFirstChild("PlotSign")
    local text = gui and gui:FindFirstChildOfClass("TextLabel")
    if text then
        text.Text = "FREE TEST BASE " .. profile.plotSlot
    end
    profiles[player] = nil
end

for slot, plot in ipairs(world.plots) do
    plot.open.Triggered:Connect(function(player)
        openAtBase(player, slot)
    end)
end
world.trainPrompt.Triggered:Connect(train)
Players.PlayerAdded:Connect(assignPlayer)
Players.PlayerRemoving:Connect(removePlayer)
for _, player in Players:GetPlayers() do
    assignPlayer(player)
end
for zoneId in ipairs(world.zones) do
    spawnCrate(zoneId)
end

RunService.Heartbeat:Connect(function(delta)
    local now = os.clock()
    local targets = {}
    local distances = {}
    for player, profile in pairs(profiles) do
        local root, human = characterRoot(player)
        local carry = profile.carry
        if root and human then
            if carry and carry.status == "Escaping" then
                local zone = world.zones[carry.zoneId]
                if root.Position.Z >= zone.safeExitZ then
                    carry.status = "Secured"
                    profile.slowUntil = 0
                    updateCarry(player, profile)
                    notify(player, "SAFE! Follow the pale return lane back to YOUR base.")
                elseif now - carry.capturedAt >= Config.GuardWakeSeconds then
                    local distance = (root.Position - zone.warden.Position).Magnitude
                    if not distances[carry.zoneId] or distance < distances[carry.zoneId] then
                        distances[carry.zoneId] = distance
                        targets[carry.zoneId] = { player = player, root = root }
                    end
                end
                if
                    carry.status == "Escaping"
                    and carry.method == "Snatch"
                    and not carry.slowApplied
                    and now - carry.capturedAt >= Config.SnatchSlowdownDelay
                then
                    carry.slowApplied = true
                    profile.slowUntil = now + Config.SnatchSlowdownSeconds
                    notify(player, "CRATE BURST! Brief slowdown — keep moving.")
                end
            end
            local speed = math.min(
                Config.WalkSpeedCap,
                Config.WalkSpeedBase + math.floor(profile.speedPower / 100)
            )
            if carry and carry.status == "Secured" then
                speed = 30 -- Test-only return pacing: keep physical travel, not instant teleport.
            elseif now < profile.slowUntil then
                speed = Config.SnatchSlowdownWalkSpeed
            end
            if human.WalkSpeed ~= speed then
                human.WalkSpeed = speed
            end
        end
    end

    for zoneId, zone in ipairs(world.zones) do
        local target = targets[zoneId]
        local position = zone.warden.Position
        local destination = if target
            then Vector3.new(target.root.Position.X, position.Y, target.root.Position.Z)
            else zone.guardOrigin
        local direction = destination - position
        local speed = if target
            then (Config.GuardSpeedBase + (zoneId - 1) * Config.GuardSpeedPerZone)
            else Config.GuardReturnSpeed
        if direction.Magnitude > 0.05 then
            zone.warden.Position = position
                + direction.Unit * math.min(direction.Magnitude, speed * math.min(delta, 0.1))
        end
        if
            target
            and (zone.warden.Position - target.root.Position).Magnitude
                <= Config.GuardCatchRadius
        then
            local profile = profiles[target.player]
            if
                profile
                and profile.carry
                and profile.carry.status == "Escaping"
                and profile.carry.zoneId == zoneId
            then
                clearCarry(target.player, profile, "WARDEN CAUGHT YOU: unsecured crate lost.")
            end
        end
    end
end)
print("[Steal a Disaster] Five-zone Studio-only original map initialized (no DataStore).")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ZoneMap</string>
          <string name="Source"><![CDATA[--!strict
-- All geometry is generated from primitive Roblox Parts: no third-party assets.
-- These are five original, lightweight test environments along ONE physical road.
local ZoneMap = {}

local THEMES = {
    {
        floor = Color3.fromRGB(99, 166, 121),
        path = Color3.fromRGB(176, 185, 166),
        accent = Color3.fromRGB(100, 204, 207),
        sky = Color3.fromRGB(199, 232, 239),
    },
    {
        floor = Color3.fromRGB(207, 192, 154),
        path = Color3.fromRGB(155, 197, 203),
        accent = Color3.fromRGB(57, 166, 217),
        sky = Color3.fromRGB(108, 188, 227),
    },
    {
        floor = Color3.fromRGB(102, 90, 94),
        path = Color3.fromRGB(154, 128, 125),
        accent = Color3.fromRGB(244, 124, 70),
        sky = Color3.fromRGB(239, 162, 97),
    },
    {
        floor = Color3.fromRGB(90, 99, 143),
        path = Color3.fromRGB(156, 164, 193),
        accent = Color3.fromRGB(182, 143, 244),
        sky = Color3.fromRGB(154, 184, 235),
    },
    {
        floor = Color3.fromRGB(108, 94, 65),
        path = Color3.fromRGB(151, 145, 112),
        accent = Color3.fromRGB(249, 139, 70),
        sky = Color3.fromRGB(223, 180, 115),
    },
}

local function style(obj: Part, material: Enum.Material, transparency: number?)
    obj.Material = material
    obj.Transparency = transparency or 0
    return obj
end

function ZoneMap.create(root: Folder, part, label, config)
    local zones = {}
    for i, definition in ipairs(config.Zones) do
        local centerZ = config.FirstZoneCenterZ - (i - 1) * config.ZoneSpacing
        local theme = THEMES[i]
        local zoneFolder = Instance.new("Folder")
        zoneFolder.Name = ("Zone%02d_%s"):format(i, definition.Name:gsub("%s+", ""))
        zoneFolder.Parent = root

        local function block(name, x, y, z, sx, sy, sz, color, collide)
            return part(
                zoneFolder,
                name,
                Vector3.new(x, y, centerZ + z),
                Vector3.new(sx, sy, sz),
                color,
                collide
            )
        end

        block("Ground", 0, -1, 0, 120, 2, config.ZoneLength, theme.floor)
        block("MainRoad", 0, 0.05, 0, 25, 0.1, config.ZoneLength, theme.path, false)
        -- Safe shoulder remains passable on the return trip, without teleporting.
        block("ReturnShoulder", 46, 0.05, 0, 12, 0.1, config.ZoneLength, theme.sky, false)
        block("WestRim", -61, 3, 0, 2, 6, config.ZoneLength, theme.accent)
        block("EastRim", 61, 3, 0, 2, 6, config.ZoneLength, theme.accent)

        local startZ = centerZ + config.ZoneLength / 2 + 1
        local gate = part(
            zoneFolder,
            "SafeExit_" .. i,
            Vector3.new(0, 0.2, startZ),
            Vector3.new(48, 0.35, 4),
            Color3.fromRGB(112, 233, 163),
            false
        )
        style(gate, Enum.Material.Neon)
        label(gate, "ExitLabel", ("ZONE %d SAFE EXIT"):format(i), Vector3.new(0, 6, 0))

        local intro = block("ZoneEntrySign", -24, 5, 83, 3, 10, 3, theme.accent, false)
        label(
            intro,
            "Name",
            ("ZONE %d - %s\nSpeed %d+"):format(i, definition.Name, definition.RequiredSpeed),
            Vector3.new(0, 10, 0)
        )

        -- The physical exit to the next Zone is always straight ahead.
        if i > 1 then
            local centerBetween = centerZ + config.ZoneSpacing / 2
            part(
                root,
                ("Link_%d_%d"):format(i - 1, i),
                Vector3.new(0, -1, centerBetween),
                Vector3.new(34, 2, config.ZoneSpacing - config.ZoneLength + 4),
                Color3.fromRGB(122, 138, 151)
            )
            part(
                root,
                ("ReturnLink_%d_%d"):format(i - 1, i),
                Vector3.new(46, -0.9, centerBetween),
                Vector3.new(12, 2, config.ZoneSpacing - config.ZoneLength + 4),
                theme.sky
            )
        end

        -- A few original shapes per theme; no imported copies of the reference.
        if i == 1 then
            for j = 1, 4 do
                local z = 60 - j * 35
                local house = block(
                    "LittleHouse" .. j,
                    if j % 2 == 0 then 34 else -36,
                    7,
                    z,
                    17,
                    14,
                    16,
                    Color3.fromRGB(235, 194 + j * 5, 162),
                    false
                )
                local roof = block(
                    "HouseRoof" .. j,
                    house.Position.X,
                    15.5,
                    z,
                    20,
                    3,
                    19,
                    Color3.fromRGB(137, 111, 139),
                    false
                )
                roof.Material = Enum.Material.Slate
            end
            local spiral = block(
                "TornadoSculpture",
                -46,
                14,
                -75,
                8,
                28,
                8,
                Color3.fromRGB(170, 229, 221),
                false
            )
            spiral.Shape = Enum.PartType.Cylinder
            style(spiral, Enum.Material.ForceField, 0.3)
        elseif i == 2 then
            for j = 1, 4 do
                local water = block(
                    "WaterStrip" .. j,
                    if j % 2 == 0 then 35 else -35,
                    0.15,
                    66 - j * 42,
                    29,
                    0.25,
                    29,
                    theme.accent,
                    false
                )
                style(water, Enum.Material.Glass, 0.45)
            end
            block("WaveWallSculpture", -43, 9, -74, 10, 18, 37, Color3.fromRGB(76, 179, 225), false)
            block("Lighthouse", 46, 22, 58, 12, 44, 12, Color3.fromRGB(234, 232, 225), false)
            block("LighthouseBeacon", 46, 46, 58, 16, 4, 16, theme.accent, false)
        elseif i == 3 then
            for j = 1, 5 do
                local x = if j % 2 == 0 then 36 else -39
                block(
                    "Basalt" .. j,
                    x,
                    5,
                    80 - j * 33,
                    14,
                    10,
                    11,
                    Color3.fromRGB(65, 62, 68),
                    false
                )
            end
            local lava =
                block("LavaRiverSculpture", -48, 0.15, -36, 17, 0.25, 112, theme.accent, false)
            style(lava, Enum.Material.Neon)
            block("VolcanoCone", 44, 20, -61, 28, 40, 28, Color3.fromRGB(73, 69, 71), false)
            style(
                block("VolcanoGlow", 44, 41, -61, 19, 3, 19, theme.accent, false),
                Enum.Material.Neon
            )
        elseif i == 4 then
            for j = 1, 4 do
                local x = if j % 2 == 0 then 38 else -39
                block(
                    "StormBuilding" .. j,
                    x,
                    12 + j * 3,
                    69 - j * 34,
                    18,
                    24 + j * 6,
                    18,
                    Color3.fromRGB(61, 69, 102),
                    false
                )
                style(
                    block(
                        "ElectricSign" .. j,
                        x,
                        25 + j * 3,
                        69 - j * 34,
                        15,
                        2,
                        3,
                        theme.accent,
                        false
                    ),
                    Enum.Material.Neon
                )
            end
        elseif i == 5 then
            for j = 1, 9 do
                local x = if j % 2 == 0 then 38 else -39
                local z = 92 - j * 20
                block("TreeTrunk" .. j, x, 10, z, 5, 20, 5, Color3.fromRGB(99, 71, 55), false)
                local crown = block(
                    "BurningCanopy" .. j,
                    x,
                    23,
                    z,
                    17,
                    17,
                    17,
                    if j % 3 == 0
                        then Color3.fromRGB(239, 130, 75)
                        else Color3.fromRGB(112, 117, 68),
                    false
                )
                crown.Shape = Enum.PartType.Ball
                if j % 3 == 0 then
                    style(crown, Enum.Material.Neon, 0.15)
                end
            end
        end

        local warden =
            block("Warden_" .. i, 0, 4, -20, 8, 8, 8, Color3.fromRGB(198, 75 + i * 9, 91), false)
        warden.Shape = Enum.PartType.Ball
        label(warden, "WardenSign", ("WARDEN - ZONE %d"):format(i), Vector3.new(0, 7, 0))

        local nodes = {
            Vector3.new(-30, 3.2, centerZ - 57),
            Vector3.new(29, 3.2, centerZ - 73),
        }
        for j, location in ipairs(nodes) do
            local pad = part(
                zoneFolder,
                "CrateSpawn" .. j,
                location - Vector3.new(0, 2.9, 0),
                Vector3.new(13, 0.3, 13),
                theme.accent,
                false
            )
            style(pad, Enum.Material.Neon, 0.2)
        end
        zones[i] = {
            id = i,
            name = definition.Name,
            folder = zoneFolder,
            nodes = nodes,
            centerZ = centerZ,
            safeExitZ = startZ + 1,
            warden = warden,
            guardOrigin = warden.Position,
        }
    end
    return zones
end

return ZoneMap
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="13">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

print(("[Client] %s prototype %s ready"):format(Config.WorkingTitle, Config.PrototypeVersion))
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="14">
          <Properties>
            <string name="Name">TornadoTownHUD</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Temporary, code-generated UI for Studio greybox tests. Player Attributes are display-only.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
    return
end
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "TornadoTownPrototypeHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Name = "StatsPanel"
panel.Size = UDim2.fromOffset(310, 142)
panel.Position = UDim2.fromOffset(12, 14)
panel.BackgroundColor3 = Color3.fromRGB(20, 27, 39)
panel.BackgroundTransparency = 0.1
panel.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = panel
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(80, 144, 172)
stroke.Thickness = 1
stroke.Parent = panel

local function makeText(name, y, height, size, color)
    local txt = Instance.new("TextLabel")
    txt.Name = name
    txt.Position = UDim2.fromOffset(12, y)
    txt.Size = UDim2.new(1, -24, 0, height)
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.BackgroundTransparency = 1
    txt.TextScaled = false
    txt.TextSize = size
    txt.Font = Enum.Font.GothamBold
    txt.TextColor3 = color or Color3.new(1, 1, 1)
    txt.TextWrapped = true
    txt.Parent = panel
    return txt
end
local title = makeText("Header", 8, 22, 16, Color3.fromRGB(146, 224, 237))
title.Text = "STEAL A DISASTER! | 5-ZONE TEST"
local money = makeText("Money", 35, 23, 15)
local speed = makeText("Speed", 60, 23, 15)
local crate = makeText("Crate", 85, 23, 15)
local index = makeText("Index", 110, 23, 14, Color3.fromRGB(194, 216, 229))
local instructions = Instance.new("TextLabel")
instructions.Name = "Help"
instructions.Size = UDim2.new(0.8, 0, 0, 58)
instructions.Position = UDim2.new(0.1, 0, 1, -69)
instructions.BackgroundColor3 = Color3.fromRGB(20, 27, 39)
instructions.BackgroundTransparency = 0.15
instructions.TextColor3 = Color3.new(1, 1, 1)
instructions.TextSize = 14
instructions.Font = Enum.Font.Gotham
instructions.TextWrapped = true
instructions.Text =
    "Train Speed to unlock Zones 1–5 → collect any Zone crate → escape its Warden → return and open at YOUR base"
instructions.Parent = gui
local helpCorner = Instance.new("UICorner")
helpCorner.CornerRadius = UDim.new(0, 10)
helpCorner.Parent = instructions

local notification = Instance.new("TextLabel")
notification.Name = "Notification"
notification.AnchorPoint = Vector2.new(0.5, 0)
notification.Position = UDim2.new(0.5, 0, 0.05, 0)
notification.Size = UDim2.new(0.7, 0, 0, 56)
notification.BackgroundColor3 = Color3.fromRGB(34, 68, 83)
notification.BackgroundTransparency = 0.08
notification.TextColor3 = Color3.new(1, 1, 1)
notification.TextSize = 16
notification.Font = Enum.Font.GothamBold
notification.TextWrapped = true
notification.Visible = false
notification.Parent = gui
local notifCorner = Instance.new("UICorner")
notifCorner.CornerRadius = UDim.new(0, 12)
notifCorner.Parent = notification
local function refresh()
    money.Text = "Chaos Coins: " .. tostring(player:GetAttribute("ChaosCoins") or 0)
    speed.Text = "Speed Power: " .. tostring(player:GetAttribute("SpeedPower") or 0)
    local status = player:GetAttribute("CarryStatus") or "Empty"
    local tier = player:GetAttribute("CarryingTier") or ""
    crate.Text = "Crate: "
        .. (
            status == "Empty" and "None"
            or (
                "Zone "
                .. tostring(player:GetAttribute("CarryingZone") or 0)
                .. " / "
                .. tier
                .. " / "
                .. status
            )
        )
    index.Text = "Unlocked Zone: "
        .. tostring(player:GetAttribute("HighestZone") or 1)
        .. "/5 | Index: "
        .. tostring(player:GetAttribute("IndexCount") or 0)
end
for _, attribute in ipairs({
    "ChaosCoins",
    "SpeedPower",
    "HighestZone",
    "CarryStatus",
    "CarryingTier",
    "CarryingZone",
    "IndexCount",
}) do
    player:GetAttributeChangedSignal(attribute):Connect(refresh)
end
refresh()

local serial = 0
local remotes = ReplicatedStorage:WaitForChild("PrototypeRemotes", 12)
if remotes then
    local notify = remotes:WaitForChild("Notify", 12)
    if notify then
        notify.OnClientEvent:Connect(function(message)
            serial += 1
            local current = serial
            notification.Text = tostring(message)
            notification.Visible = true
            task.delay(5, function()
                if current == serial then
                    notification.Visible = false
                end
            end)
        end)
    end
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
