          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict

-- Shared, non-sensitive configuration only.
local Config = {
    WorkingTitle = "Steal a Disaster",
    PrototypeVersion = "0.1.0",
}

return table.freeze(Config)
]]></string>
        </Properties>
